{
  "name": "reviewgate",
  "version": "0.1.0",
  "description": "Human approval gateway for AI-proposed actions",
  "type": "module",
  "bin": {
    "reviewgate": "dist/src/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test dist/test/*.test.js",
    "check": "npm run test && node dist/src/cli.js demo --policy examples/policy.json --ledger .tmp/reviewgate-demo.jsonl",
    "start": "node dist/src/cli.js serve --policy examples/policy.json --ledger .data/events.jsonl"
  },
  "keywords": [
    "ai",
    "automation",
    "human-in-the-loop",
    "approval",
    "audit"
  ],
  "author": "kanu",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^24.3.0",
    "typescript": "^7.0.2"
  }
}
